<footer class="footer">
  <div class="wrap footer__grid">

    <div class="footer__col footer__about">
      <a class="logo logo--footer" href="/" aria-label="{{ site.name }} — home">
        <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
          <rect width="48" height="48" rx="10" fill="#fff"/>
          <path d="M14 32V20l10-6 10 6v12h-7v-8h-6v8z" fill="var(--brand)"/>
        </svg>
        <span class="logo__text"><strong>City College of Management</strong></span>
      </a>
      <p>{{ site.description }}</p>
      <ul class="social" aria-label="Social media">
        <li><a href="{{ site.social.facebook }}" aria-label="Facebook"><svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M13 22v-8h3l.5-4H13V7.5c0-1 .3-1.5 1.7-1.5H17V2.2C16.6 2.1 15.3 2 13.9 2 11 2 9 3.7 9 6.9V10H6v4h3v8z"/></svg></a></li>
        <li><a href="{{ site.social.instagram }}" aria-label="Instagram"><svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2c2.7 0 3 0 4.1.1 1 0 1.8.2 2.4.5.7.3 1.2.6 1.7 1.2.6.5.9 1 1.2 1.7.3.6.4 1.4.5 2.4 0 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1-.2 1.8-.5 2.4-.3.7-.6 1.2-1.2 1.7-.5.6-1 .9-1.7 1.2-.6.3-1.4.4-2.4.5-1.1 0-1.4.1-4.1.1s-3 0-4.1-.1c-1 0-1.8-.2-2.4-.5-.7-.3-1.2-.6-1.7-1.2-.6-.5-.9-1-1.2-1.7-.3-.6-.4-1.4-.5-2.4C2 15 2 14.7 2 12s0-3 .1-4.1c0-1 .2-1.8.5-2.4.3-.7.6-1.2 1.2-1.7.5-.6 1-.9 1.7-1.2.6-.3 1.4-.4 2.4-.5C9 2 9.3 2 12 2m0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10m0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4M18.4 6.8a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0"/></svg></a></li>
        <li><a href="{{ site.social.youtube }}" aria-label="YouTube"><svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M22 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.8C18.3 5 12 5 12 5s-6.3 0-7.9.5A2.5 2.5 0 0 0 2.4 7.3C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.7 1.8C5.7 19 12 19 12 19s6.3 0 7.9-.5a2.5 2.5 0 0 0 1.7-1.8C22 15.2 22 12 22 12M10 15.5v-7l6 3.5z"/></svg></a></li>
        <li><a href="{{ site.social.linkedin }}" aria-label="LinkedIn"><svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M6.9 21H3.3V9h3.6zM5.1 7.4A2.1 2.1 0 1 1 5.1 3a2.1 2.1 0 0 1 0 4.4M21 21h-3.6v-6.3c0-1.6-.6-2.6-2-2.6-1.1 0-1.7.7-2 1.4-.1.3-.1.7-.1 1V21H9.7V9h3.6v1.7c.5-.8 1.4-1.9 3.4-1.9 2.5 0 4.3 1.6 4.3 5.1z"/></svg></a></li>
      </ul>
      <p class="footer__note"><span class="ph">[Add Facebook, Instagram, YouTube and LinkedIn URLs in site.json]</span></p>
    </div>

    <div class="footer__col">
      <h2 class="footer__head">Programmes</h2>
      <ul class="footer__list">
        {%- for p in programmes %}
        <li><a href="/courses/{{ p.slug }}/">{{ p.name }}</a></li>
        {%- endfor %}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__head">Quick Links</h2>
      <ul class="footer__list">
        {%- for item in nav.quickLinks %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__head">Contact</h2>
      <address class="footer__address">
        <p>{{ site.name }},<br>
          {{ site.address.street }},<br>
          {{ site.address.locality }},<br>
          {{ site.address.region }} {{ site.address.postalCode | ph | safe }}<br>
          <span class="muted">{{ site.address.landmark }}</span>
        </p>
        <p>
          <a href="{{ site.phoneHref }}" data-track="call">Phone: {{ site.phone | ph | safe }}</a><br>
          <a href="{{ site.whatsappHref }}" data-track="whatsapp">WhatsApp: {{ site.whatsapp | ph | safe }}</a><br>
          <a href="{{ site.emailHref }}">Email: {{ site.email | ph | safe }}</a>
        </p>
        <p>Office hours: {{ site.officeHours | ph | safe }}</p>
      </address>
      <a class="btn btn--ghost btn--sm" href="{{ site.mapDirections }}" target="_blank" rel="noopener">Get Directions</a>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="wrap footer__bottom-inner">
      <p>&copy; {{ now.year }} {{ site.legalLine }}.</p>
      <ul class="footer__legal">
        {%- for item in nav.legal %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</footer>

{# Fixed bar on mobile only: Call, WhatsApp, Apply. #}
<nav class="mobilebar" aria-label="Quick actions">
  <a href="{{ site.phoneHref }}" data-track="call">
    <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
    <span>Call</span>
  </a>
  <a href="{{ site.whatsappHref }}" data-track="whatsapp">
    <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.4A10 10 0 1 0 12 2m5 14.1c-.2.6-1.2 1.2-1.7 1.2-.4 0-1 0-2.2-.5a10 10 0 0 1-4-3.5c-.7-1-1.1-2-1.1-2.8 0-.8.4-1.4.8-1.8.3-.3.6-.3.8-.3h.5c.2 0 .4 0 .5.4l.8 1.8c0 .2 0 .3-.1.5l-.4.5c-.1.2-.2.3 0 .5.4.8 1 1.4 1.7 1.9.3.2.6.4 1 .5.2.1.3 0 .5-.1l.7-.8c.2-.2.3-.1.5 0l1.6.8c.3.2.4.3.4.5s0 .6-.1.8"/></svg>
    <span>WhatsApp</span>
  </a>
  <a class="mobilebar__cta" href="/admissions/#apply">
    <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm2 16H8v-2h8zm0-4H8v-2h8zm-3-6V3.5L18.5 9z"/></svg>
    <span>Apply</span>
  </a>
</nav>
