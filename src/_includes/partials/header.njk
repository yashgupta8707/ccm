<a class="skip-link" href="#main">Skip to main content</a>

<div class="topbar">
  <div class="wrap topbar__inner">
    <p class="topbar__contact">
      <a href="{{ site.phoneHref }}" data-track="call">
        <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
        <span>{{ site.phone | ph | safe }}</span>
      </a>
      <a href="{{ site.emailHref }}">
        <svg class="ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 4-8 5-8-5V6l8 5 8-5z"/></svg>
        <span>{{ site.email | ph | safe }}</span>
      </a>
    </p>
    <p class="topbar__links">
      <a href="/admissions/"><strong>Admissions {{ site.admissionSession }} Open &rarr;</strong></a>
      <a href="/news-events/">News &amp; Events</a>
      <a href="{{ site.parentUrl }}" target="_blank" rel="noopener">City Group of Colleges</a>
    </p>
  </div>
</div>

<header class="header" id="siteHeader">
  <div class="wrap header__inner">
    <a class="logo" href="/" aria-label="{{ site.name }} — home">
      {# Text and SVG logo placeholder: replace with the college's own logo file. #}
      <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
        <rect width="48" height="48" rx="10" fill="var(--brand)"/>
        <path d="M14 32V20l10-6 10 6v12h-7v-8h-6v8z" fill="#fff"/>
      </svg>
      <span class="logo__text">
        <strong>City College of Management</strong>
        <small>Chinhat, Lucknow &middot; Since {{ site.established }}</small>
      </span>
    </a>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="primaryNav">
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="sr-only">Menu</span>
    </button>

    <nav class="nav" id="primaryNav" aria-label="Primary">
      <ul class="nav__list">
        {%- for item in nav.primary %}
        <li>
          <a href="{{ item.url }}"
             {% if page.url == item.url or (item.url != '/' and page.url.startsWith(item.url)) %}aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {%- endfor %}
      </ul>
      <a class="btn btn--primary nav__cta" href="/admissions/#apply">Apply Now</a>
    </nav>
  </div>
</header>
